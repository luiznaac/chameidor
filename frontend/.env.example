# Base URL of the chameidor backend API.
# In dev, leave as "/api" and Vite proxies to VITE_API_TARGET (see vite.config.ts).
# In prod behind the reverse proxy, set to e.g. "/chameidor-api" or the absolute origin.
VITE_API_BASE=/api

# Dev-only: where the Vite proxy forwards /api to.
VITE_API_TARGET=http://localhost:8100

# Dev-only: the Vite server port (project block role `frontend-dev`).
FRONTEND_DEV_PORT=8103
