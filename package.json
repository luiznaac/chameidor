{
  "name": "chameidor-monorepo",
  "private": true,
  "description": "Task runner for the chameidor monorepo (backend/ + frontend/). Not a real Node package — just scripts.",
  "scripts": {
    "setup": "npm --prefix frontend install",
    "be:unit": "cd backend && ./gradlew unitTest --no-daemon",
    "be:integration": "cd backend && ./gradlew :integrationTest:test --no-daemon",
    "be:build": "cd backend && ./gradlew clean build --no-daemon",
    "be:test": "cd backend && ./gradlew test --no-daemon",
    "be:detekt": "cd backend && ./gradlew detekt --no-daemon",
    "db:migrate": "cd backend && ./gradlew :persistence:migrate --no-daemon",
    "db:generate": "cd backend && ./gradlew :persistence:generateMigrationScript --no-daemon",
    "fe:dev": "npm --prefix frontend run dev",
    "fe:build": "npm --prefix frontend run build",
    "fe:typecheck": "npm --prefix frontend run typecheck",
    "fe:lint": "npm --prefix frontend run lint",
    "fe:test": "npm --prefix frontend run test",
    "precommit": "npm run be:detekt && npm run be:unit && npm run fe:typecheck && npm run fe:test",
    "check": "npm run be:build && npm run fe:typecheck && npm run fe:build",
    "db": "docker compose -f backend/docker-compose.yml up -d mysql",
    "up": "docker compose up --build",
    "down": "docker compose down"
  }
}
